# ====================================================================
# CREDIT WALLET 2.0 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Hướng dẫn:
# 1. Sao chép tệp này sang .env trên máy chủ production:
#    cp .env.production.example .env
# 2. Điền mật khẩu mạnh và các API Keys thật
# 3. Phân quyền tệp chỉ root/deployer đọc được: chmod 600 .env
# ====================================================================

# --- A. CẤU HÌNH HỆ THỐNG CHUNG ---
PROJECT_NAME="Credit Wallet 2.0 API"
DEBUG=false
API_V1_STR=/api/v1
WORKERS=4
LOG_LEVEL=info

# Cổng truy cập Web (Mặc định 80 cho HTTP, đứng sau Nginx reverse proxy hoặc Cloudflare)
WEB_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432

# CORS Tường lửa (Chỉ cho phép domain/IP của bạn gọi API)
# Ví dụ: ["http://localhost", "https://your-domain.com", "https://wallet.yourdomain.vn"]
BACKEND_CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "https://your-domain.com"]

# --- B. CẤU HÌNH DATABASE (Chọn 1 trong 2 nguồn bên dưới) ---

# [LỰA CHỌN 1]: SỬ DỤNG DOCKER POSTGRES CỤC BỘ TRÊN MÁY CHỦ
# Khi chạy lệnh: docker compose -f docker-compose.prod.yml --profile local up -d --build
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[your_password_here]
POSTGRES_DB=credit_wallet
POSTGRES_SSLMODE=

# [LỰA CHỌN 2]: SỬ DỤNG SUPABASE CLOUD HOẶC MANAGED DB (AWS RDS / DIGITALOCEAN)
# Khi chạy lệnh: docker compose -f docker-compose.prod.yml up -d --build
# POSTGRES_HOST=aws-0-[region].pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_USER=postgres.[your_project_ref]
# POSTGRES_PASSWORD=[your_supabase_database_password]
# POSTGRES_DB=postgres
# POSTGRES_SSLMODE=require

# Database Connection Pooling Parameters (Hiệu chỉnh cho Gunicorn Multi-Workers)
# Mỗi worker sở hữu connection pool riêng biệt: Tổng connection = WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Với WORKERS=4: 4 * (5 + 5) = tối đa 40 connections (an toàn tuyệt đối trong ngưỡng 60-100 của PostgreSQL/Supabase).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# --- C. TÍCH HỢP AI COPILOT & STATEMENT EXTRACTION (Tùy chọn) ---
# Lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=[your_production_gemini_api_key_here]

# --- D. TÍCH HỢP TELEGRAM BOT ALERTS & 2-WAY INTERACTION (Tùy chọn) ---
# Tạo bot qua @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=[your_telegram_bot_token_here]
TELEGRAM_CHAT_ID=[your_telegram_chat_id_here]
# Secret token xác thực webhook (bắt buộc nếu sử dụng Webhook thay vì Long-polling)
TELEGRAM_WEBHOOK_SECRET=[your_telegram_webhook_secret_token_here]

# Automated Background Alert Scheduler & Worker Coordination
ENABLE_BACKGROUND_SCHEDULER=true
ALERT_SCAN_INTERVAL_HOURS=6
# Chế độ chạy Background Service trong môi trường Gunicorn Multi-Worker:
# - "auto" (Khuyến nghị): Tự động bầu cử Leader qua PostgreSQL Advisory Lock (chỉ 1 worker chạy, các worker khác standby)
# - "false": Tắt background service trên cụm API (dùng khi bạn chạy container worker riêng biệt: python -m app.worker)
# - "true": Luôn bật leader election
RUN_BACKGROUND_SERVICES=auto
BACKGROUND_LOCK_ID=88481234

# --- E. GOOGLE SHEETS ETL INGESTION (Tùy chọn) ---
GOOGLE_SHEET_ID=16kks0eL-j7SNxBAR3NlU5n1viIEvTjg-fAu9yWC9mAk
